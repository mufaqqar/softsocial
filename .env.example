# ---------------------------------------------------------------------------
# SoftSocial - environment variables
#
# Copy to .env (Next.js reads it too) and fill in real values.
# NEVER commit a file containing real secrets.
#
# Phases 1 and 2 are a manual publishing tool and need nothing below the
# database/media sections. Phase 3 automatic publishing is implemented but
# stays inert until ENCRYPTION_KEY, REDIS_URL and the Meta/LinkedIn
# credentials below are set; missing values are reported by
# /dashboard/connections instead of crashing the app.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) -------------------------------------------------
# DATABASE_URL is used at runtime by the app. On serverless hosts use the
# POOLED connection string so the app does not exhaust the connection limit.
# DIRECT_URL is used by the Prisma CLI for migrations and must be a DIRECT
# (non-pooled) connection.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/softsocial?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/softsocial?schema=public"

# --- App -------------------------------------------------------------------
# Server-side base URL, used to build the OAuth callback URI handed to Meta and
# LinkedIn. REQUIRED for Phase 3. It must be the public origin exactly, with no
# trailing slash, because the provider compares it byte for byte against the
# redirect URI registered in the provider app.
APP_URL="http://localhost:3000"

# 32-byte secret for signing the session cookie (HS256 JWT).
# Generate: openssl rand -base64 32
# REQUIRED. Only presence is checked, so a placeholder would be accepted and
# every session cookie would be forgeable. Use a real value.
AUTH_SECRET="replace-with-openssl-rand-base64-32"

# --- Media storage ---------------------------------------------------------
# STORAGE_PROVIDER: "local" (filesystem, development only) or "supabase"
# (durable, required on serverless hosts such as Vercel).
STORAGE_PROVIDER="local"

# Local filesystem driver. Relative paths resolve from the project root.
STORAGE_LOCAL_DIR="./storage"

# Supabase Storage driver. Required when STORAGE_PROVIDER=supabase.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="media"

# ---------------------------------------------------------------------------
# Phase 3: automatic publishing
# ---------------------------------------------------------------------------

# --- Token encryption (REQUIRED) ------------------------------------------
# 32-byte key used to encrypt Meta and LinkedIn tokens at rest (AES-256-GCM).
# Generate: openssl rand -base64 32
#
# Changing this value makes every stored token unreadable. Connections will show
# as needing to be reconnected, and posts will have to be reconnected rather
# than retried. Keep it stable and keep a copy of it in your secret manager.
ENCRYPTION_KEY=""

# --- Queue (REQUIRED) ------------------------------------------------------
# Redis for BullMQ. The web app only produces jobs; the worker consumes them,
# so both must reach the same instance.
# Local:   redis://localhost:6379
# Upstash: rediss://default:<password>@<host>:6379
REDIS_URL="redis://localhost:6379"

# How many posts the worker publishes at once. Keep this modest: each publish is
# an upload plus a provider round trip, and both providers rate limit per app.
WORKER_CONCURRENCY="4"

# --- Meta / Facebook Pages -------------------------------------------------
# From developers.facebook.com -> your app -> Settings -> Basic.
#
# Register this exact redirect URI in the app:
#   {APP_URL}/api/oauth/meta/callback
#
# Permissions to request and have reviewed for Live / Standard Access:
#   pages_show_list, pages_manage_posts, pages_manage_metadata,
#   pages_read_engagement
META_APP_ID=""
META_APP_SECRET=""

# --- LinkedIn --------------------------------------------------------------
# From linkedin.com/developers/apps -> your app -> Auth -> Client credentials.
#
# Register this exact redirect URI in the app:
#   {APP_URL}/api/oauth/linkedin/callback
#
# Requested scopes: w_organization_social, r_organization_social.
# Publishing to an ORGANISATION page additionally requires the app to be
# approved for the Community Management API product, and the authorising
# member must be an Administrator or Content Administrator of that Page.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
